{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyntral.invalid/schema/execution-receipt.v1.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Kyntral ExecutionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receiptId",
    "actionId",
    "deviceId",
    "actionHash",
    "outcome",
    "startedAt",
    "completedAt",
    "counts",
    "deviceProof"
  ],
  "properties": {
    "version": { "const": "kyntral.receipt.v1" },
    "receiptId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$" },
    "actionId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$" },
    "deviceId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,127}$" },
    "actionHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "outcome": { "enum": ["completed", "partial", "failed", "cancelled"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "failed"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "deviceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 3, "maxLength": 128 },
        "algorithm": { "const": "ES256" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  }
}
