{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyntral.invalid/schema/execution-receipt.v1.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "Kyntral ExecutionReceipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "receiptId", "actionId", "deviceId", "outcome", "startedAt", "completedAt", "counts", "receiptHash", "deviceSignature"],
  "properties": {
    "version": { "const": "kyntral.receipt.v1" },
    "receiptId": { "type": "string" },
    "actionId": { "type": "string" },
    "deviceId": { "type": "string" },
    "outcome": { "enum": ["completed", "partial", "failed", "cancelled"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "failed"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "receiptHash": { "type": "string" },
    "deviceSignature": { "type": "string" }
  }
}
