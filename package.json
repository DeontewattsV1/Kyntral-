{
  "name": "kyntral",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Privacy-first permission layer between AI systems and user-owned devices.",
  "scripts": {
    "typecheck": "tsc -p control-plane/tsconfig.json --noEmit && tsc -p tsconfig.conformance.json --noEmit",
    "build": "tsc -p control-plane/tsconfig.json",
    "test": "vitest run control-plane/tests",
    "conformance": "vitest run conformance",
    "security:audit": "npm audit --audit-level=high",
    "sbom": "npm sbom --sbom-format=cyclonedx"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
